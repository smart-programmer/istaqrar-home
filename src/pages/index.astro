---
import BaseLayout from '../layouts/BaseLayout.astro';
import cert1 from '../../cert7.png';
import cert2 from '../../cert8.png';
import cert3 from '../../cert6.png';
import logoIstaqrar from '../../logo-istaqrar2.jpeg';
const logoPath = logoIstaqrar.src;
---
<BaseLayout title="استقرار الجودة" description="شريكك الموثوق في رحلة الجودة والتميز.">
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-white">
      <!-- Hero Logo placed on the left -->
      <div class="absolute left-4 md:left-8 top-6" aria-label="شعار المؤسسة">
        <img src={logoPath} alt="مؤسسة استقرار الجودة" class="h-[4.2rem] md:h-[5.6rem] w-auto" loading="eager" decoding="async" />
      </div>
      <div class="container relative py-24 md:py-32">
        <div class="max-w-3xl" data-aos="fade-up">
          <h1 class="text-4xl md:text-6xl font-extrabold mb-4 text-primary-900">استقرار الجودة</h1>
          <p class="text-gray-800 mb-4">مرحباً بكم في مؤسسة استقرار الجودة</p>
          <p class="text-gray-700 mb-8">مؤسسة مهتمة ومتخصصة في تطوير وتحسين أمن وجودة السلامة الغذائية والحلول التشغيلية</p>
          <a href="#contact" class="inline-flex items-center gap-2 bg-accent hover:bg-[#d84f4e] text-white px-6 py-3 rounded-lg shadow-lg transition">
            <span>تواصل معنا</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Certificates Strip -->
    <section class="bg-gray-50 border-y border-gray-100">
      <div class="container py-6 md:py-8">
        <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
          <img src={cert1.src} alt="شهادة جودة وسلامة غذائية" class="h-20 md:h-28 w-auto object-contain" loading="lazy" decoding="async" />
          <img src={cert2.src} alt="شهادة ISO في سلامة الأغذية" class="h-[5.5rem] md:h-[7.75rem] w-auto object-contain" loading="lazy" decoding="async" />
          <img src={cert3.src} alt="شهادة اعتماد في الجودة والسلامة" class="h-[7.25rem] md:h-[10rem] w-auto object-contain" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="grid md:grid-cols-3 gap-8 items-center">
            <div class="md:col-span-2" data-aos="fade-up">
              <h2 class="section-title">من نحن</h2>
              <div class="h-1 w-16 bg-accent rounded-full mt-2 mb-4"></div>
              <p class="section-subtitle">هي مؤسسة تأسست عام 2025 مهتمة ومتخصصة في تطوير وتحسين أمن وجودة السلامة الغذائية والحلول التشغيلية. ندعم المنشآت الصغيرة والمتوسطة والكبيرة للمحافظة على أعلى مستوى من الجودة والسلامة الغذائية وبناء وتطوير الخطط التشغيلية</p>
            </div>
            <div class="flex justify-center md:justify-end" data-aos="fade-left">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-tr from-accent to-primary-600 grid place-items-center shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 14h-2v-2h2v2zm0-4h-2V6h2v6z"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Goal -->
    <section class="py-12 bg-gray-50">
      <div class="container">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100" data-aos="fade-up">
          <h2 class="section-title">هدفنا</h2>
          <div class="h-1 w-16 bg-accent rounded-full mt-2 mb-4"></div>
          <p class="section-subtitle">أن نكون الجهة المانحة لشهادة الامتثال للمعايير المحلية والعالمية في أمن وجودة السلامة الغذائية، والمعتمدة محليًا من الجهات الحكومية</p>
        </div>
      </div>
    </section>

    <!-- Vision -->
    <section class="py-12">
      <div class="container">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100" data-aos="fade-up">
          <h2 class="section-title">رؤيتنا</h2>
          <div class="h-1 w-16 bg-accent rounded-full mt-2 mb-4"></div>
          <p class="section-subtitle">تحتل المملكة العربية السعودية المرتبة 49 عالميًا في أمن وجودة السلامة الغذائية. رؤيتنا أن نسهم في وضع المملكة ضمن مصاف دول العالم في جودة وأمن السلامة الغذائية.</p>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="py-12 bg-gray-50">
      <div class="container">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100" data-aos="fade-up">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-full bg-accent/10 text-accent grid place-items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h2 class="section-title !mb-0">خدماتنا</h2>
          </div>
          <div class="h-1 w-16 bg-accent rounded-full mt-2 mb-6"></div>
          <div class="grid md:grid-cols-2 gap-4 section-subtitle">
            <div class="space-y-3">
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">1</span>
                <p>قسم جودة متكامل</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">2</span>
                <p>4 زيارات شهرية</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">3</span>
                <p>تطوير وتحسين الخطط التشغيلية</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">4</span>
                <p>تطبيق أنظمة ISO</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">5</span>
                <p>تطبيق نظام HACCP (هاسب)</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">6</span>
                <p>تدريب ميداني فوري أثناء الزيارة</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent/10 text-accent text-xs">7</span>
                <p>تقارير تفصيلية عن كل زيارة</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Us -->
    <section class="py-12">
      <div class="container">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100" data-aos="fade-up">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-full bg-accent/10 text-accent grid place-items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h2 class="section-title !mb-0">لماذا نحن؟</h2>
          </div>
          <div class="h-1 w-16 bg-accent rounded-full mt-2 mb-6"></div>
          <div class="grid md:grid-cols-2 gap-4 section-subtitle">
            <div class="space-y-3">
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                <p>دعم كامل للمنشآت الصغيرة والمتوسطة والكبيرة</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                <p>بناء وتطوير الخطط التشغيلية</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                <p>تحسين الامتثال لأنظمة الجودة والسلامة الغذائية</p>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                <p>خبرة ميدانية حقيقية</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="container py-16 md:py-20">
      <h2 class="section-title" data-aos="fade-up">تواصل معنا</h2>
      <div class="grid sm:grid-cols-3 gap-6" data-aos="fade-up" data-aos-delay="100">
        <a href="https://wa.me/966593283732" target="_blank" rel="noopener" class="group flex items-center gap-3 bg-white rounded-lg p-4 shadow-sm border border-gray-100 hover:border-accent">
          <div class="w-12 h-12 rounded-lg bg-accent/10 text-accent grid place-items-center mb-4">
            <!-- WhatsApp icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-6 w-6" fill="currentColor" aria-hidden="true">
              <path d="M19.11 17.18c-.28-.14-1.65-.81-1.9-.9-.26-.1-.45-.14-.64.14-.19.28-.73.9-.9 1.09-.17.19-.33.21-.61.07-.28-.14-1.17-.43-2.23-1.38-.82-.73-1.38-1.63-1.54-1.9-.16-.28-.02-.43.12-.57.12-.12.28-.33.42-.5.14-.17.19-.28.28-.47.09-.19.05-.36-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.55-.46-.47-.64-.48l-.55-.01c-.19 0-.5.07-.76.36-.26.28-1 1-1 2.44 0 1.44 1.03 2.83 1.17 3.02.14.19 2.03 3.1 4.92 4.35.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.12.56-.08 1.65-.67 1.88-1.32.23-.65.23-1.21.16-1.32-.07-.11-.26-.18-.54-.32z"/>
              <path d="M26.73 5.27A13.5 13.5 0 0 0 2.5 16.37L1 27l10.8-1.43A13.49 13.49 0 1 0 26.73 5.27zM11.9 23.96l-6.83.9.91-6.69-.04-.07a11.53 11.53 0 1 1 5.96 5.86z"/>
            </svg>
          </div>
          <div>
            <div class="font-semibold">واتساب</div>
            <div class="text-gray-600 text-sm">+966593283732</div>
          </div>
        </a>
        <a href="mailto:info@istaqrar.sa" class="group flex items-center gap-3 bg-white rounded-lg p-4 shadow-sm border border-gray-100 hover:border-accent">
          <div class="w-10 h-10 rounded-lg bg-accent/10 text-accent grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg>
          </div>
          <div>
            <div class="font-semibold">البريد الإلكتروني</div>
            <div class="text-gray-600 text-sm">info@istaqrar.sa</div>
          </div>
        </a>
        <a href="https://www.istaqrar.sa" target="_blank" rel="noopener" class="group flex items-center gap-3 bg-white rounded-lg p-4 shadow-sm border border-gray-100 hover:border-accent">
          <div class="w-10 h-10 rounded-lg bg-accent/10 text-accent grid place-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div>
            <div class="font-semibold">الموقع الإلكتروني</div>
            <div class="text-gray-600 text-sm">www.istaqrar.sa</div>
          </div>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 bg-primary-900 text-white">
      <div class="container text-center text-sm">© {new Date().getFullYear()} استقرار الجودة</div>
    </footer>
  </main>
</BaseLayout>
